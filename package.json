{
  "name": "lavande",
  "version": "0.1.0",
  "description": "A calm, lavender-themed AI terminal companion for daily tasks.",
  "type": "module",
  "bin": {
    "lavande": "./bin/lavande.js"
  },
  "main": "./dist/index.js",
  "files": [
    "dist",
    "bin",
    "README.md"
  ],
  "scripts": {
    "dev": "tsx src/index.tsx",
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "start": "node bin/lavande.js"
  },
  "keywords": [
    "ai",
    "terminal",
    "cli",
    "gemini",
    "ink",
    "assistant"
  ],
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@9.15.4",
  "dependencies": {
    "@google/genai": "^2.0.0",
    "cac": "^6.7.14",
    "chalk": "^5.3.0",
    "clipboardy": "^4.0.0",
    "date-fns": "^3.6.0",
    "dotenv": "^16.4.5",
    "env-paths": "^3.0.0",
    "execa": "^9.5.1",
    "figures": "^6.1.0",
    "ink": "^5.0.1",
    "ink-big-text": "^2.0.0",
    "ink-gradient": "^3.0.0",
    "ink-spinner": "^5.0.0",
    "ink-text-input": "^6.0.0",
    "react": "^18.3.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.12",
    "tsup": "^8.3.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
