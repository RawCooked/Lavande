# Lavande configuration
# Copy this file to .env and fill in the values.

# Your Google AI Studio API key (https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=

# Optional: override the default model
# Examples: gemini-2.5-flash, gemini-2.5-pro, gemini-2.0-flash
LAVANDE_MODEL=gemini-2.5-flash

# Optional: provider selection (default: gemini)
# Supported: gemini, minicpm
# LAVANDE_PROVIDER=gemini

# MiniCPM (local, via Python bridge). Start the server first:
#   python minicpm_server.py
# Then set:
#   LAVANDE_PROVIDER=minicpm
#   LAVANDE_MODEL=openbmb/MiniCPM5-1B
# Optional override (default http://127.0.0.1:8088/chat):
#   MINICPM_URL=http://127.0.0.1:8088/chat

# Optional: enable debug logging to a file in the data directory
# LAVANDE_DEBUG=1
